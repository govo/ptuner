# Fastlane Fastfile — App Store Connect automation lanes

require "json"
require "tempfile"

default_platform(:ios)

APP_STORE_CONNECT_ISSUER_ID = ENV["APP_STORE_CONNECT_ISSUER_ID"]
APP_STORE_CONNECT_KEY_ID = ENV["APP_STORE_CONNECT_KEY_ID"]
APP_STORE_CONNECT_KEY_FILEPATH = ENV["APP_STORE_CONNECT_KEY_FILEPATH"]

def api_key
  app_store_connect_api_key(
    key_id: APP_STORE_CONNECT_KEY_ID,
    issuer_id: APP_STORE_CONNECT_ISSUER_ID,
    key_filepath: APP_STORE_CONNECT_KEY_FILEPATH,
    duration: 1200,
    in_house: false
  )
end

def api_key_path
  key = api_key
  file = Tempfile.new(["asc_api_key_", ".json"])
  file.write(key.to_json)
  file.close
  file.path
end

def project_root
  File.expand_path("..", __dir__)
end

platform :ios do
  desc "Validate metadata without uploading anything"
  lane :precheck_metadata do
    # API key 无法校验内购项，排除 IAP 规则；元数据本身的字数/格式校验仍会执行
    precheck(api_key: api_key, include_in_app_purchases: false)
  end

  desc "Upload ONLY name/subtitle/keywords for all locales (no build, no screenshots, no IAP, no precheck)"
  lane :upload_aso do
    deliver(
      api_key: api_key,
      metadata_path: "./fastlane/metadata_aso_only",
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload ONLY description for all locales (no build, no screenshots, no other metadata, no IAP, no precheck)"
  lane :upload_description do
    deliver(
      api_key: api_key,
      metadata_path: "./fastlane/metadata_desc_only",
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload metadata and screenshots only (no build)"
  lane :upload_metadata do
    upload_aso
  end

  desc "Upload screenshots only"
  lane :upload_screenshots do
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      force: true
    )
  end

  desc "Download current metadata from App Store Connect"
  lane :download_metadata do
    key_path = api_key_path
    sh("cd '#{project_root}' && fastlane deliver download_metadata --api_key_path #{key_path}")
  end

  desc "Download current screenshots from App Store Connect"
  lane :download_screenshots do
    key_path = api_key_path
    sh("cd '#{project_root}' && fastlane deliver download_screenshots --api_key_path #{key_path}")
  end

  desc "Initialize project by downloading existing metadata and screenshots"
  lane :init_from_app_store do
    key_path = api_key_path
    sh("cd '#{project_root}' && fastlane deliver download_metadata --api_key_path #{key_path}")
    sh("cd '#{project_root}' && fastlane deliver download_screenshots --api_key_path #{key_path}")
  end

  desc "Upload a new IPA build"
  lane :upload_build do |options|
    ipa_path = options[:ipa]
    UI.user_error!("Missing ipa: path") unless ipa_path
    deliver(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end

  desc "Upload IPA + metadata + screenshots and optionally submit for review"
  lane :release do |options|
    ipa_path = options[:ipa]
    submit = options[:submit_for_review] || false
    UI.user_error!("Missing ipa: path") unless ipa_path
    deliver(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: submit,
      automatic_release: false,
      force: true
    )
  end

  desc "Submit the current version for review"
  lane :submit_review do
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true
    )
  end

  desc "Upload build to TestFlight"
  lane :upload_testflight do |options|
    ipa_path = options[:ipa]
    UI.user_error!("Missing ipa: path") unless ipa_path
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: false
    )
  end
end
