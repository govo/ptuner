# ============================================================
# PTuner .gitignore
# 参考 demucs/SplitJam 的忽略规则，按 PTuner（iOS + macOS）场景收敛。
# 原则：构建产物、用户级配置、模型权重、大体积媒体与凭据一律不入库。
# ============================================================

# ---------- 构建产物 ----------
build/
DerivedData/
*.xcbuild
*.xcresult
*.xcarchive
*.ipa
*.dSYM/
*.dSYM.zip

# xcodebuild -derivedDataPath 指向仓库内的本地产物
.xcode/
.xcode-*/

# ---------- Xcode 用户级状态 ----------
# scheme 管理、断点、窗口状态等因人而异，不提交
xcuserdata/
*.xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# 注意：不使用参考项目里的 *.resolved 规则。
# PTuner 有远程 SPM 依赖（Sentry），Package.resolved 需要入库以锁定版本：
#   PTuner/PTuner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# ---------- Swift Package Manager ----------
.build/
.swiftpm/
Packages/

# ---------- 模型与权重（大文件，不入库） ----------
# Core ML
*.mlmodel
*.mlmodelc
*.mlpackage/

# 训练 / 导出权重
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
*.tflite
*.gguf
*.h5
*.keras

# 本地模型目录（从远端下载或脚本生成）
Models/

# ---------- 音频 / 视频测试素材 ----------
# 调音测试用的原始音频与预览视频体积大，放本地或对象存储
*.wav
*.aif
*.aiff
*.caf
*.flac
*.mp3
*.m4a
*.ogg
*.mp4
*.mov
*.mkv

# ---------- 设计源文件 ----------
*.psd
*.ai
*.sketch
*.fig
*.aep

# ---------- 凭据与签名文件 ----------
# 绝对不要提交
.env
.env.*
!.env.example
.sentryclirc
.sentry-user-token.env
AuthKey_*.p8
*.p8
*.p12
*.cer
*.mobileprovision
.netrc

# ---------- Fastlane / App Store 素材 ----------
# 截图与预览视频数量多、体积大，由发版流程单独管理
# 仓库根已上移到 ptuner/，fastlane 位于子目录，使用 **/ 匹配任意层级
**/fastlane/screenshots/
**/fastlane/screenshots_macos/
**/fastlane/app_previews/
**/fastlane/test_output/
**/fastlane/report.xml
**/fastlane/Preview.html
.staging-screenshots/

# ---------- 营销截图物料 ----------
# 原始截图与合成预览体积大（约 340MB），且可由模拟器截图 + 合成脚本重新生成，
# 不入库；只提交 doc/marketing/compose_screenshots.py。
doc/screenshots-raw/
doc/marketing/preview/

# ---------- 日志与诊断 ----------
*.log
*.crash
*.profdata
*.lcov
coverage/
_sentry_export/

# ---------- Python（模型转换脚本可能用到） ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
env/
.venv/
.venv-*/
dist/

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.sublime-*
.claude/settings.local.json

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
__MACOSX/
*.swp
*.swo
*~
